{
  "expo": {
    "name": "LegalX",
    "slug": "legalx-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "legalx",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.legalx.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LegalX uses your camera for video consultations with an advocate.",
        "NSMicrophoneUsageDescription": "LegalX uses your microphone for voice and video consultations with an advocate.",
        "NSPhotoLibraryUsageDescription": "LegalX lets you choose a profile photo and attach documents to a consultation.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.legalx.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#C9A227",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F0",
          "image": "./assets/images/legalx-logo.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4A91F",
          "defaultChannel": "default",
          "icon": "./assets/images/adaptive-monochrome.png"
        }
      ],
      "./plugins/withAbiFilters"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FBF9F6",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62c91cd9-f3ca-4cc9-9f9b-c0c733351ee7"
      }
    },
    "owner": "karolix"
  }
}
