# LegalX Mobile — Environment Variables
#
# Copy this file to .env.local for local development.
# Never commit actual credentials to version control.
# Three environments: Dev | Staging | Production (see 23_Release_Environment_Strategy.md §1)
#
# ─── Supabase ────────────────────────────────────────────────────────────────
# Each environment must point to its own Supabase project.
# Dev and Staging must NEVER point at the Production Supabase project.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Dev/Staging: use Razorpay test mode keys only.
# Production: use Razorpay live keys — enforce this via separate EAS build profiles.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ─── Agora ────────────────────────────────────────────────────────────────────
# Dev/Staging: Agora test/sandbox App ID.
# Production: Agora production App ID.
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id

# ─── App Environment ──────────────────────────────────────────────────────────
# Values: "development" | "staging" | "production"
EXPO_PUBLIC_APP_ENV=development
