# LegalX Mobile — copy to .env for local development.
#
# EXPO_PUBLIC_ values are inlined into the JavaScript bundle at build time, so
# none of them is a secret: whatever is here ships inside the app. Anything that
# must stay private belongs on the backend.
#
# EAS builds read these from eas.json instead, because the build runs from a
# clean checkout where this file is not present.

# Supabase project. The anon key is the publishable one — row-level security
# decides what it can reach, and the service-role key never leaves the server.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# LegalX backend. Every rule worth enforcing lives behind this.
EXPO_PUBLIC_API_URL=https://legalx-backend-gl4b.onrender.com
